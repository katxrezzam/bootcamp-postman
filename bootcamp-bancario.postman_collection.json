{
  "info": {
    "_postman_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "name": "Bootcamp Bancario",
    "description": "Coleccion de verificacion funcional de los microservicios del sistema bancario (proyecto-bootcamp). El enunciado exige que toda funcionalidad se verifique con Postman, sin interfaz grafica. Un folder por microservicio; se va ampliando a medida que se agregan servicios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "customer-service",
      "item": [
        {
          "name": "Crear cliente personal (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('tiene id', () => pm.expect(pm.response.json().id).to.be.a('string'));",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('personalCustomerId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"71234567\",\n  \"firstName\": \"Katherine\",\n  \"lastName\": \"Ramos\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Crear cliente empresarial (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('businessCustomerId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
