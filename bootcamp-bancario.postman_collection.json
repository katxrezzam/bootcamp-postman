          "request": {
            "method": "GET",
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{personalCustomerId}}",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{personalCustomerId}}"]
