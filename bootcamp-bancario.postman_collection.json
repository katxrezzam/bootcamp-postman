            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"BUSINESS\",\n  \"documentType\": \"RUC\",\n  \"documentNumber\": \"20123456789\",\n  \"businessName\": \"Acme SAC\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Crear con documentNumber duplicado (409)",
          "event": [
